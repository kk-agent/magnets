# Magnets Supabase Edge Function local example.
# Copy to supabase/.env.local for local use only. Never commit real values.

# Shared bearer token for POST /functions/v1/agent-post
MAGNETS_AGENT_POST_BEARER_TOKEN=replace-with-a-long-random-shared-secret

# Supabase admin client wiring for post persistence and widget token lookup
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# APNs widget push wiring
# Local .p8 key path: ~/.config/gcp-secrets/AuthKey_GJSN7LZ8SP.p8
MAGNETS_APNS_KEY_ID=GJSN7LZ8SP
MAGNETS_APNS_TEAM_ID=6DR32PXU4V
MAGNETS_APNS_TOPIC=com.groupthinking.magnets.widget
MAGNETS_APNS_ENV=development
MAGNETS_APNS_P8_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_LOCAL_SECRET_ONLY\n-----END PRIVATE KEY-----"
