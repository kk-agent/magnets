# Magnets Supabase Edge Function local example.
# Copy to supabase/.env.local for local use only. Never commit real values.

# Shared bearer token for POST /functions/v1/agent-post
MAGNETS_AGENT_POST_BEARER_TOKEN=replace-with-a-long-random-shared-secret

# CloudKit / backend bridge wiring
MAGNETS_CLOUDKIT_CONTAINER_ID=iCloud.com.groupthinking.magnets
MAGNETS_CLOUDKIT_BRIDGE_BASE_URL=https://example.invalid/cloudkit-bridge
MAGNETS_CLOUDKIT_MANAGEMENT_TOKEN=optional-placeholder-for-schema-or-config-automation

# APNs widget push wiring
MAGNETS_APNS_KEY_ID=U43LDC7HYX
MAGNETS_APNS_TEAM_ID=6DR32PXU4V
MAGNETS_APNS_TOPIC=com.groupthinking.magnets.widget
MAGNETS_APNS_ENV=development
MAGNETS_APNS_P8_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_LOCAL_SECRET_ONLY\n-----END PRIVATE KEY-----"

# Temporary token routing for early testing.
# Replace this env var with real token storage once WidgetPushHandler tokens are persisted server-side.
MAGNETS_WIDGET_PUSH_TOKEN_MAP_JSON='{"sample-magnet-id":["sample-device-token"]}'
